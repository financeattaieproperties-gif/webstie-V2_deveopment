Options -Indexes
<FilesMatch "^paths(?:\.example)?\.php$">
 Require all denied
</FilesMatch>
RewriteEngine On
RewriteRule ^v1(?:/.*)?$ index.php [L]
<IfModule mod_headers.c>
 Header always set X-Robots-Tag "noindex, nofollow, noarchive"
 Header always set Cache-Control "private, no-store"
</IfModule>
